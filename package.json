{
  "name": "a-table",
  "version": "1.6.0",
  "author": "appleple",
  "description": "Editable table library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appleple/a-table.js.git"
  },
  "bugs": {
    "url": "https://github.com/appleple/a-table.js/issues"
  },
  "homepage": "https://github.com/appleple/a-table.js#readme",
  "scripts": {
    "test": "npm run lint && npm run test:ci",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "build": "tsup",
    "watch": "tsup --watch",
    "serve": "vite",
    "dev": "concurrently \"npm:watch\" \"npm:serve\"",
    "prepack": "npm run lint:check && npm run test:ci && npm run build",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./build/*": "./build/*",
    "./css/*": "./css/*",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "lib",
    "build",
    "css",
    "fonts"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "a-template": "^0.8.1"
  }
}
